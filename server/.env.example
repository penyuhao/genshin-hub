# ===== 原神功能快捷站 后端环境变量模板 =====
# 复制为 .env 并填写真实值

KUMA_URL=
KUMA_STATUS_SLUG=
KUMA_API_KEY=
KUMA_USERNAME=
KUMA_PASSWORD=
KUMA_SOCKET_ENABLED=false

PORT=3001
NODE_ENV=development
POLL_INTERVAL=30
CACHE_TTL=30

ALLOWED_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-64-byte-random-hex
JWT_EXPIRES_IN=24h

# 图形验证码测试旁路令牌（留空 = 无旁路，生产建议留空）
CAPTCHA_BYPASS_TOKEN=
# ---- 限流 ----
API_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
# 生产环境务必保持 false
RATE_LIMIT_BYPASS_LOOPBACK=false