# ============================================================
#  原神功能快捷站 · 环境变量模板
#  用法： cp server/.env.example server/.env  然后按需修改
#  说明： 全部都有默认值 —— 一个都不填也能 npm start 跑起来
#         （首次启动会自动生成 JWT 密钥与随机管理员密码并打印到控制台）
# ============================================================

# ---------- 服务 ----------
PORT=3001
# 监听地址：0.0.0.0 = 所有网卡（容器/PaaS 推荐）；127.0.0.1 = 仅本机
HOST=0.0.0.0
# production 时启用 HSTS、隐藏 5xx 细节、严格限流（生产务必设置）
NODE_ENV=development
# 反向代理层数：默认 1（Nginx 等单层）；直连填 false；也支持 loopback / true
TRUST_PROXY=1

# ---------- 目录（可移植性）----------
# 运行时数据目录：配置 / 凭据 / 备份 / 上传 / 自动生成的密钥
#   容器或 PaaS 建议指向挂载卷，例如 DATA_DIR=/data
#   留空 = server/data
DATA_DIR=
# 后台上传文件目录，留空 = DATA_DIR/uploads
UPLOAD_DIR=
# 前端静态资源目录（一般不用改）
FRONTEND_DIR=

# ---------- Uptime Kuma 数据源 ----------
# 三项都留空 = Mock 演示模式；也可登录后台「数据源设置」里填（面板优先）
KUMA_URL=
KUMA_STATUS_SLUG=
KUMA_API_KEY=
# 可选：Socket.IO 实时通道（需要 Kuma 账号密码）
KUMA_USERNAME=
KUMA_PASSWORD=
KUMA_SOCKET_ENABLED=false
# 状态轮询间隔（秒）与缓存时长（秒）
POLL_INTERVAL=30
CACHE_TTL=30

# ---------- 安全 ----------
# CORS 白名单（逗号分隔）；同源部署保持默认即可
ALLOWED_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
# API 限流：每 IP 每 15 分钟上限
API_RATE_LIMIT_MAX=100
# 登录失败限流：每 IP 每 15 分钟上限
LOGIN_RATE_LIMIT_MAX=10
# 本机开发豁免（仅非生产生效，生产必须 false）
RATE_LIMIT_BYPASS_LOOPBACK=false

# ---------- 管理员凭据 ----------
# 留空 = 首次启动自动生成随机密码并打印到控制台（推荐）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# bcrypt 哈希（优先级高于明文）：node -e "console.log(require('bcryptjs').hashSync('你的密码',12))"
ADMIN_PASSWORD_HASH=
# 留空 = 首次启动自动生成并保存到 DATA_DIR/secrets.json
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ---------- 测试 ----------
# 自动化测试用的验证码旁路令牌（留空 = 无旁路；生产建议留空）
CAPTCHA_BYPASS_TOKEN=
