# ---------- 依赖与缓存 ----------
node_modules/
.npm-cache/

# ---------- 环境变量（含密钥，绝不提交）----------
.env
.env.local
server/.env
!server/.env.example

# ---------- 运行时数据 ----------
# 默认数据目录 server/data：除出厂模板外全部忽略
# （配置 / 凭据 / 数据源密钥 / 备份 / 上传 / 自动生成的密钥）
server/data/*
!server/data/config.default.json

# 若用 DATA_DIR 指向仓库内其他目录（如 ./data），同样忽略
/data/
*.sqlite
*.sqlite3

# ---------- 旧版上传目录（当前上传已改到数据目录）----------
frontend/images/uploads/*
!frontend/images/uploads/.gitkeep
frontend/fonts/uploads/*
!frontend/fonts/uploads/.gitkeep

# ---------- 本机专用 ----------
.local/
.tmp-*
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ---------- 字体素材原始 Release 包（已按需提取到 frontend/fonts）----------
HoYo-Glyphs-Release/
__MACOSX/
